{
  "name": "vlp-snowflake-sink",
  "connector.class": "com.snowflake.kafka.connector.SnowflakeSinkConnector",
  "tasks.max": "2",
  "topics": "vlp.shipping.veloship-shipment.v1,vlp.ops.tracking-event.v1,vlp.finance.invoice.v1,vlp.sales.crm-object.v1",
  "snowflake.topic2table.map": "vlp.shipping.veloship-shipment.v1:KAFKA_VELOSHIP_SHIPMENTS,vlp.ops.tracking-event.v1:KAFKA_TRACKING_EVENTS,vlp.finance.invoice.v1:KAFKA_INVOICES,vlp.sales.crm-object.v1:KAFKA_CRM_OBJECTS",
  "snowflake.ingestion.method": "SNOWPIPE_STREAMING",
  "snowflake.enable.schematization": "false",
  "snowflake.url.name": "${SNOWFLAKE_URL}",
  "snowflake.user.name": "SVC_AIVEN_CONNECTOR",
  "snowflake.private.key": "${SNOWFLAKE_PRIVATE_KEY}",
  "snowflake.role.name": "VLP_CONNECTOR",
  "snowflake.database.name": "VLP_DP",
  "snowflake.schema.name": "BRONZE",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "buffer.flush.time": "10",
  "snowflake.streaming.max.client.lag": "30",
  "errors.tolerance": "all",
  "errors.log.enable": "true",
  "errors.deadletterqueue.topic.name": "vlp.dlq.s3-sink.v1",
  "errors.deadletterqueue.topic.replication.factor": "1",
  "errors.deadletterqueue.context.headers.enable": "true"
}
