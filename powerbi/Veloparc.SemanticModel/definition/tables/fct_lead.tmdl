	partition fct_lead = m
		mode: import
		source =
				let
				    Source = fnVeloparcTable("GOLD", "FCT_LEAD", {{"lead_id", type text}, {"created_date_key", Int64.Type}, {"converted_opportunity_id", type text}, {"country_code", type text}, {"lead_source", type text}, {"status", type text}})
