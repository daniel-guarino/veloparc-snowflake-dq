model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table _Measures
ref table dim_date
ref table dim_month
ref table dim_country
ref table dim_customer
ref table dim_depot
ref table dim_partner_zone
ref table dim_tariff
ref table fct_invoice_line
ref table fct_gl_revenue
ref table fct_parcel
ref table fct_parcel_event
ref table fct_partner_cost
ref table fct_opportunity
ref table fct_lead
ref table dq_scorecard_daily
ref table dq_issue
ref table dq_detection_eval

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SnowflakeServer", "Warehouse", "Role", "Database", "VeloparcDb", "fnVeloparcTable", "_Measures", "dim_date", "dim_month", "dim_country", "dim_customer", "dim_depot", "dim_partner_zone", "dim_tariff", "fct_invoice_line", "fct_gl_revenue", "fct_parcel", "fct_parcel_event", "fct_partner_cost", "fct_opportunity", "fct_lead", "dq_scorecard_daily", "dq_issue", "dq_detection_eval"]
