{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veloparc-study:source:crm_object",
  "title": "CRM object (Opportunity or Lead)",
  "description": "Objetos ao estilo Salesforce; o tipo vem em attributes.type. Destino bronze: BRONZE.RAW_CRM_OBJECTS.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "attributes",
        "Id",
        "AccountId",
        "Name",
        "StageName",
        "CloseDate",
        "Country__c",
        "LastModifiedDate"
      ],
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "Opportunity"
            }
          }
        },
        "Id": {
          "type": "string",
          "pattern": "^006[A-Za-z0-9]{15}$"
        },
        "AccountId": {
          "type": "string",
          "pattern": "^001[A-Za-z0-9]{15}$"
        },
        "VLP_ContactID__c": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-Z]{10}$",
              "description": "Identificador do expedidor atribuído pela Veloparc (ContactID). Formato fictício.",
              "examples": [
                "351000123A"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Preenchido quando a conta já é cliente Veloparc"
        },
        "Name": {
          "type": "string",
          "maxLength": 120
        },
        "StageName": {
          "type": "string",
          "enum": [
            "Prospecting",
            "Qualification",
            "Proposal",
            "Negotiation",
            "Closed Won",
            "Closed Lost"
          ]
        },
        "Amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "CurrencyIsoCode": {
          "type": "string",
          "enum": [
            "EUR",
            "PLN",
            "CZK",
            "HUF",
            "DKK",
            "RON"
          ],
          "description": "ISO 4217 (moedas dos países Veloparc do case)"
        },
        "CloseDate": {
          "type": "string",
          "format": "date"
        },
        "Country__c": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2",
          "examples": [
            "PT",
            "ES",
            "DE",
            "FR",
            "PL"
          ]
        },
        "Expected_Parcels_Month__c": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "LastModifiedDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+0000$",
          "description": "Formato Salesforce, UTC"
        }
      },
      "if": {
        "properties": {
          "StageName": {
            "const": "Closed Won"
          }
        }
      },
      "then": {
        "properties": {
          "Amount": {
            "type": "number"
          }
        },
        "required": [
          "Amount"
        ]
      }
    },
    {
      "type": "object",
      "required": [
        "attributes",
        "Id",
        "Company",
        "LeadSource",
        "Status",
        "CreatedDate"
      ],
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "Lead"
            }
          }
        },
        "Id": {
          "type": "string",
          "pattern": "^00Q[A-Za-z0-9]{15}$"
        },
        "Company": {
          "type": "string",
          "maxLength": 120
        },
        "Country": {
          "type": "string",
          "maxLength": 60,
          "description": "Texto livre no CRM (ex.: 'Spain', 'ES', 'España'): normalizado na silver"
        },
        "LeadSource": {
          "type": "string",
          "enum": [
            "Web",
            "Referral",
            "Event",
            "Partner",
            "Outbound"
          ]
        },
        "Status": {
          "type": "string",
          "enum": [
            "Open",
            "Working",
            "Qualified",
            "Unqualified",
            "Converted"
          ]
        },
        "ConvertedOpportunityId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^006[A-Za-z0-9]{15}$"
        },
        "CreatedDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+0000$"
        }
      },
      "if": {
        "properties": {
          "Status": {
            "const": "Converted"
          }
        }
      },
      "then": {
        "properties": {
          "ConvertedOpportunityId": {
            "type": "string"
          }
        },
        "required": [
          "ConvertedOpportunityId"
        ]
      }
    }
  ]
}
