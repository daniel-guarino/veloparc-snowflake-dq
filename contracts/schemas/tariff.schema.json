{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veloparc-study:source:tariff",
  "title": "Customer tariff",
  "description": "Uma tarifa por cliente, produto e zona, com escalões de peso. Destino bronze: BRONZE.RAW_TARIFFS.",
  "type": "object",
  "required": [
    "tariffId",
    "contactId",
    "product",
    "zone",
    "currency",
    "validFrom",
    "weightBands"
  ],
  "additionalProperties": false,
  "properties": {
    "tariffId": {
      "type": "string",
      "pattern": "^TRF-[0-9A-Z]{10}-(PARCEL|EXPRESS|FREIGHT)-Z[0-9]-[0-9]{4}$",
      "examples": [
        "TRF-351000123A-PARCEL-Z1-0002"
      ]
    },
    "contactId": {
      "type": "string",
      "pattern": "^[0-9A-Z]{10}$",
      "description": "Identificador do expedidor atribuído pela Veloparc (ContactID). Formato fictício.",
      "examples": [
        "351000123A"
      ]
    },
    "product": {
      "type": "string",
      "enum": [
        "PARCEL",
        "EXPRESS",
        "FREIGHT"
      ]
    },
    "zone": {
      "type": "string",
      "pattern": "^[A-Z]{2}-Z[0-9]$",
      "description": "Zona postal: país + zona",
      "examples": [
        "PT-Z1",
        "ES-Z3"
      ]
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "PLN",
        "CZK",
        "HUF",
        "DKK",
        "RON"
      ],
      "description": "ISO 4217 (moedas dos países Veloparc do case)"
    },
    "validFrom": {
      "type": "string",
      "format": "date"
    },
    "validTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fuelSurchargePct": {
      "type": "number",
      "minimum": 0,
      "maximum": 30
    },
    "weightBands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "fromKg",
          "toKg",
          "price"
        ],
        "additionalProperties": false,
        "properties": {
          "fromKg": {
            "type": "number",
            "minimum": 0
          },
          "toKg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  },
  "$comment": "Regras que o schema não exprime: escalões contíguos (toKg[n] = fromKg[n+1]), primeiro fromKg = 0, preço crescente; validTo > validFrom; sem sobreposição de validade por (contactId, product, zone)."
}
