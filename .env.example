# Copy to .env and fill in locally. .env is git-ignored. Never commit real values.

# Snowflake (key-pair auth for the service user)
SNOWFLAKE_ACCOUNT=<org-account>
SNOWFLAKE_USER=SVC_VELOPARC_CI
SNOWFLAKE_ROLE=VLP_TRANSFORMER
SNOWFLAKE_WAREHOUSE=WH_TRANSFORM
SNOWFLAKE_DATABASE=VLP_DP
SNOWFLAKE_PRIVATE_KEY_PATH=/path/outside/the/repo/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>

# AWS
AWS_REGION=eu-west-3
AWS_PROFILE=<profile-name>
VLP_LANDING_BUCKET=vlp-dp-landing-dev-<suffix>

# Aiven Kafka. In this project these are secrets of the GitHub Environment `dev` (ADR 0002), not a local file.
KAFKA_BOOTSTRAP_SERVERS=<service>.aivencloud.com:<sasl-port>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=<username>
KAFKA_SASL_PASSWORD=<password>
KAFKA_SSL_CA_PEM=<content of the project CA certificate, BEGIN to END lines>
SCHEMA_REGISTRY_URL=https://<service>.aivencloud.com:<port>
SCHEMA_REGISTRY_BASIC_AUTH=<username>:<password>
